# Existing
MONGODB_URI=
MONGODB_URI_TEST=
SECRET=
PORT=3001
DEVICE_ENC_KEY=

# Assistant (all optional except DATABASE_URL and GEMINI_API_KEY; without
# those the assistant routes answer 503 and the rest of Backend runs normally)
DATABASE_URL=postgres://agotek:agotek@localhost:5432/agotek_automation   # same Postgres as IOT, needs pgvector
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash             # free tier: 20 requests/day. With billing enabled: gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite   # tried in order on overload/timeout/quota; empty disables
IOT_URL=http://localhost:3002            # confirmed rule proposals are created through IOT's /api/rules
EMBEDDING_PROVIDER=gemini                # gemini (API, no RAM cost) | local (e5-small in-process, ~500 MB RAM, needs devDependencies)
# EMBEDDING_MODEL=gemini-embedding-001   # default per provider; local: Xenova/multilingual-e5-small
# EMBEDDING_DIM=768                      # default per provider (local: 384); changing it makes the next ingest re-embed everything
RAG_TOP_K=8
# RAG_MIN_SIMILARITY=0.62               # default per provider (gemini 0.62, local 0.80); tune with `npm run eval`
# RAG_CORPUS_DIR=../Agricultural_resources
# MODEL_CACHE_DIR=./.model-cache         # local provider only
# EMBEDDING_DTYPE=q8                     # local provider only
# ASSISTANT_MAX_STEPS=6
# GEMINI_TIMEOUT_MS=30000
# ASSISTANT_RATE_LIMIT_PER_MIN=8
# ASSISTANT_PROPOSAL_TTL_MINUTES=30

# npm run eval
# EVAL_API_URL=http://localhost:3001
# EVAL_USERNAME=
# EVAL_PASSWORD=
